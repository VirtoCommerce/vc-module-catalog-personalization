<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>False</IsPackable>
    <noWarn>1591;NU1608</noWarn>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.CatalogPersonalizationModule.Core\VirtoCommerce.CatalogPersonalizationModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.CatalogPersonalizationModule.Data.MySql\VirtoCommerce.CatalogPersonalizationModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.CatalogPersonalizationModule.Data.PostgreSql\VirtoCommerce.CatalogPersonalizationModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.CatalogPersonalizationModule.Data.SqlServer\VirtoCommerce.CatalogPersonalizationModule.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.CatalogPersonalizationModule.Data\VirtoCommerce.CatalogPersonalizationModule.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>